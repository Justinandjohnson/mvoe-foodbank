# Cloudflare Pages will not serve paths containing "@", so the vector-icons
# fonts 404 into the SPA catch-all below and render as tofu boxes.
# Serve them from a clean path instead, keeping the hashed filenames.
/assets/node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/*  /fonts/:splat  200

# SPA catch-all — must stay last.
/*    /index.html   200
