{
  "expo": {
    "name": "Mvoe",
    "slug": "mvoe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Mvoe",
      "shortName": "Mvoe",
      "description": "Transparent food bank donations with AI automation",
      "startUrl": "/",
      "display": "standalone",
      "themeColor": "#2E7D32",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "mvoe",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Mvoe uses your photos so you can show what food is available."
        }
      ]
    ]
  }
}