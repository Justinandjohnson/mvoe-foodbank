# Copy to .env and fill in values

DATABASE_URL=postgresql+asyncpg://user:pass@localhost/mvoe

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# At least 32 random characters
JWT_SECRET=change-me-32-chars-minimum-required
# Optional: set to the Node backend JWT_SECRET so Expo account tokens can call protected volunteer routes
NODE_JWT_SECRET=

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_VERIFY_SERVICE_SID=VA...

SENTRY_DSN=
ENVIRONMENT=development
# Set in shared/staged/production deployments so all Python backend instances
# enforce one tenant/IP limit. Leave blank only for local single-process dev.
REDIS_URL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
FRONTEND_URL=http://localhost:19006
PUBLIC_TENANT_ID=f663aa3a-fdc7-4653-841d-a5a8418a3543
