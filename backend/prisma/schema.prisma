// Prisma Schema - Phase 1 Foundation
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// DIRECTORY ENUMS - additive, introduced 2026-09-22 for the freshness/reconciliation work.
// Every field that uses these carries a @default, so existing rows migrate without backfill.
// ============================================================================

// What kind of resource a directory entry is. Mirrors the frontend marker palette 1:1.
enum VenueType {
  food_bank
  pantry
  community_fridge
  meal
  pop_up
  program
  event
}

enum AvailabilityWindowKind {
  recurring
  date_specific
}

// Where an entry came from. Keeps a person's on-the-map beacon strictly separate from
// a venue we discovered by scraping, so the two can never be conflated in queries.
enum EntryOrigin {
  scraped
  partner
  user_beacon
}

// Reconciliation state of a scraped source record against the directory:
// matched = this source corresponds to an entry we already have;
// unmatched = the source mentions a place we do NOT have (an "online has it, we don't" gap);
// ignored = deliberately not reconciled (blocked/irrelevant domain).
enum SourceMatchStatus {
  matched
  unmatched
  ignored
}

// ============================================================================
// PHASE 1: FOUNDATION TABLES
// ============================================================================

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String   @map("password_hash")
  fullName             String?  @map("full_name")
  userType             String   @default("donor") @map("user_type") // 'donor', 'volunteer', 'admin'
  visibilityPreference String   @default("first_name") @map("visibility_preference") // 'full_name', 'first_name', 'anonymous'
  isVerified           Boolean  @default(false) @map("is_verified")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  donations         Donation[]
  foodBeacons       FoodBeacon[]
  grantWorkspaces   GrantWorkspace[]
  moderationReports ModerationReport[]

  @@map("users")
}

model Organization {
  id                 String   @id @default(uuid())
  name               String
  type               String   @default("food_bank") // 'food_bank', 'church', 'company'
  description        String?
  address            String?
  city               String?
  state              String?
  zipCode            String?  @map("zip_code")
  phone              String?
  email              String?
  website            String?
  verificationStatus String   @default("pending") @map("verification_status") // 'pending', 'verified', 'rejected'
  stripeAccountId    String?  @unique @map("stripe_account_id")
  isActive           Boolean  @default(true) @map("is_active")
  // Phase 2: Geolocation fields
  latitude           Float?
  longitude          Float?
  hours              String? // JSON string of operating hours
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  donations      Donation[]
  ledgerEntries  LedgerEntry[]
  members        OrganizationMember[]
  foodNeeds      FoodNeed[]
  meals          Meal[]
  status         FoodBankStatus?
  impactMetrics  ImpactMetric[]
  receiptPhotos  ReceiptPhoto[]
  directoryEntry FoodBankDirectoryEntry?

  @@index([latitude, longitude])
  @@map("organizations")
}

model Donation {
  id                  String   @id @default(uuid())
  donorId             String?  @map("donor_id")
  organizationId      String   @map("organization_id")
  amountCents         Int      @map("amount_cents")
  stripChargeId       String   @unique @map("stripe_charge_id")
  stripePaymentIntent String?  @map("stripe_payment_intent")
  status              String   @default("succeeded") // 'pending', 'succeeded', 'failed', 'refunded'
  isRecurring         Boolean  @default(false) @map("is_recurring")
  recurringInterval   String?  @map("recurring_interval") // 'monthly', 'quarterly', 'yearly'
  isAnonymous         Boolean  @default(false) @map("is_anonymous")
  receiptUrl          String?  @map("receipt_url")
  taxReceiptSent      Boolean  @default(false) @map("tax_receipt_sent")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  donor         User?         @relation(fields: [donorId], references: [id], onDelete: SetNull)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([donorId])
  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("donations")
}

model LedgerEntry {
  id             String   @id @default(uuid())
  donationId     String?  @map("donation_id")
  organizationId String   @map("organization_id")
  entryType      String   @map("entry_type") // 'FUNDS_CAPTURED', 'FUNDS_SPENT', 'REFUND', 'ADJUSTMENT'
  amountCents    Int      @map("amount_cents")
  balanceCents   Int      @map("balance_cents") // Running balance after this entry
  description    String?
  category       String? // 'food', 'delivery', 'overhead', 'equipment'
  vendor         String?
  receiptUrl     String?  @map("receipt_url")
  metadata       Json? // Flexible field for additional data
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  donation         Donation?         @relation(fields: [donationId], references: [id], onDelete: SetNull)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detailedExpenses DetailedExpense[]
  receiptPhotos    ReceiptPhoto[]

  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@index([entryType])
  @@index([category])
  @@map("ledger_entries")
}

// ============================================================================
// SYSTEM TABLES
// ============================================================================

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // 'LOGIN', 'DONATION', 'EXPENSE_LOG', 'USER_UPDATE'
  entityType String?  @map("entity_type") // 'user', 'donation', 'organization'
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ModerationReport {
  id                String    @id @default(uuid())
  reporterUserId    String?   @map("reporter_user_id")
  reporterSessionId String?   @map("reporter_session_id")
  entityType        String    @map("entity_type") // 'food_beacon', 'community_event', 'food_bank', 'volunteer', 'grant_workspace'
  entityId          String    @map("entity_id")
  reason            String
  details           String?
  status            String    @default("open") // 'open', 'reviewing', 'resolved', 'dismissed'
  severity          String    @default("medium") // 'low', 'medium', 'high', 'urgent'
  metadata          Json?
  resolvedBy        String?   @map("resolved_by")
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  reporter User? @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([status, severity, createdAt(sort: Desc)])
  @@index([reporterUserId])
  @@index([reporterSessionId])
  @@map("moderation_reports")
}

// ============================================================================
// PHASE 2: FOOD BANK INTEGRATION TABLES
// ============================================================================

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("staff") // 'admin', 'staff', 'volunteer'
  permissions    Json? // Flexible permissions object
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model FoodBankStatus {
  id                 String   @id @default(uuid())
  organizationId     String   @unique @map("organization_id")
  waitTimeMinutes    Int?     @map("wait_time_minutes")
  foodAvailable      String?  @default("unknown") @map("food_available") // 'available', 'low', 'out', 'unknown'
  capacityPercentage Int?     @map("capacity_percentage") // 0-100
  notes              String?
  lastUpdated        DateTime @default(now()) @map("last_updated")
  updatedBy          String?  @map("updated_by") // User ID of staff who updated
  isStale            Boolean  @default(false) @map("is_stale") // Auto-set true after 2 hours

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([lastUpdated])
  @@map("food_bank_status")
}

model FoodNeed {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  itemName       String   @map("item_name")
  quantity       String? // e.g., "50 lbs", "100 cans"
  priority       String   @default("medium") // 'urgent', 'high', 'medium', 'low'
  description    String?
  isFulfilled    Boolean  @default(false) @map("is_fulfilled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([priority])
  @@index([isFulfilled])
  @@map("food_needs")
}

model Meal {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  mealName       String   @map("meal_name")
  mealDate       DateTime @map("meal_date")
  servings       Int      @default(0)
  description    String?
  status         String   @default("planned") // 'planned', 'in_progress', 'completed', 'cancelled'
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteerShifts VolunteerShift[]
  deliveries      Delivery[]

  @@index([organizationId])
  @@index([mealDate])
  @@index([status])
  @@map("meals")
}

model VolunteerShift {
  id          String   @id @default(uuid())
  mealId      String   @map("meal_id")
  volunteerId String?  @map("volunteer_id")
  shiftType   String   @map("shift_type") // 'prep', 'cooking', 'serving', 'cleanup', 'delivery'
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  status      String   @default("open") // 'open', 'filled', 'completed', 'cancelled'
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([volunteerId])
  @@index([shiftType])
  @@index([status])
  @@map("volunteer_shifts")
}

model Delivery {
  id               String   @id @default(uuid())
  mealId           String   @map("meal_id")
  volunteerId      String?  @map("volunteer_id")
  recipientName    String?  @map("recipient_name")
  recipientAddress String   @map("recipient_address")
  recipientPhone   String?  @map("recipient_phone")
  deliveryTime     DateTime @map("delivery_time")
  status           String   @default("scheduled") // 'scheduled', 'in_transit', 'delivered', 'failed'
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([volunteerId])
  @@index([status])
  @@index([deliveryTime])
  @@map("deliveries")
}

// ============================================================================
// PHASE 3B: COMMUNITY EVENTS & ENHANCED FEATURES
// ============================================================================

model CommunityEvent {
  id                 String   @id @default(uuid())
  organizerId        String?  @map("organizer_id")
  organizerSessionId String?  @map("organizer_session_id")
  eventName          String   @map("event_name")
  eventType          String   @default("community_meal") @map("event_type") // 'community_meal', 'potluck', 'barbecue', 'distribution', 'other'
  description        String?
  eventDate          DateTime @map("event_date")
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  location           String?
  latitude           Float?
  longitude          Float?
  targetServings     Int      @map("target_servings")
  budgetCents        Int?     @map("budget_cents")
  status             String   @default("planned") // 'planned', 'active', 'completed', 'cancelled'
  isPublic           Boolean  @default(true) @map("is_public")
  maxVolunteers      Int?     @map("max_volunteers")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  volunteers      EventVolunteer[]
  resources       EventResource[]
  mealPlan        EventMealPlan?
  dietaryProfiles EventDietaryProfile[]

  @@index([organizerId])
  @@index([organizerSessionId])
  @@index([eventDate])
  @@index([status])
  @@index([isPublic])
  @@index([latitude, longitude])
  @@map("community_events")
}

model FoodBeacon {
  id             String    @id @default(uuid())
  userId         String?   @unique @map("user_id")
  sessionId      String?   @unique @map("session_id")
  title          String    @default("Food available")
  description    String?
  locationLabel  String?   @map("location_label")
  latitude       Float
  longitude      Float
  quantityLevel  String    @default("some") @map("quantity_level") // 'few', 'some', 'many'
  foodTypes      String?   @map("food_types")
  photoUrl       String?   @map("photo_url")
  availableFrom  DateTime  @default(now()) @map("available_from")
  availableUntil DateTime? @map("available_until")
  isActive       Boolean   @default(true) @map("is_active")
  isPublic       Boolean   @default(true) @map("is_public")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, isPublic])
  @@index([latitude, longitude])
  @@map("food_beacons")
}

model FoodBankIndexRegion {
  id            String    @id @default(uuid())
  city          String
  state         String
  country       String    @default("US")
  searchQueries Json?     @map("search_queries")
  // Per-city knobs, so adding a city is config-only and never a schema change:
  // { radiusKm, bbox: { minLat, minLng, maxLat, maxLng }, cadence, sources: [...] }
  config        Json?
  isActive      Boolean   @default(true) @map("is_active")
  lastRunAt     DateTime? @map("last_run_at")
  nextRunAt     DateTime? @map("next_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  runs          FoodBankIndexRun[]
  entries       FoodBankDirectoryEntry[]
  sourceRecords FoodBankSourceRecord[]
  sources       FoodBankSource[]

  @@unique([city, state, country])
  @@index([isActive, nextRunAt])
  @@map("food_bank_index_regions")
}

model FoodBankIndexRun {
  id               String    @id @default(uuid())
  regionId         String    @map("region_id")
  status           String    @default("queued") // 'queued', 'running', 'completed', 'failed'
  runType          String    @default("weekly_sync") @map("run_type") // 'weekly_sync', 'manual_sync'
  jobId            String?   @map("job_id")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  discoveredCount  Int       @default(0) @map("discovered_count")
  newCount         Int       @default(0) @map("new_count")
  changedCount     Int       @default(0) @map("changed_count")
  autoAppliedCount Int       @default(0) @map("auto_applied_count")
  reviewCount      Int       @default(0) @map("review_count")
  skippedCount     Int       @default(0) @map("skipped_count")
  errorMessage     String?   @map("error_message")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")

  region        FoodBankIndexRegion       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  changes       FoodBankDirectoryChange[]
  sourceRecords FoodBankSourceRecord[]

  @@index([regionId, createdAt(sort: Desc)])
  @@index([status])
  @@map("food_bank_index_runs")
}

model FoodBankDirectoryEntry {
  id               String    @id @default(uuid())
  regionId         String    @map("region_id")
  organizationId   String?   @unique @map("organization_id")
  canonicalName    String    @map("canonical_name")
  normalizedName   String    @map("normalized_name")
  fingerprint      String    @unique
  sourceUrl        String?   @map("source_url")
  sourceDomain     String?   @map("source_domain")
  website          String?
  websiteDomain    String?   @map("website_domain")
  phone            String?
  normalizedPhone  String?   @map("normalized_phone")
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?   @map("zip_code")
  latitude         Float?
  longitude        Float?
  hours            String?
  description      String?
  eligibilityNotes String?   @map("eligibility_notes")
  // --- additive 2026-09-22: type, provenance, freshness, reconciliation ---
  venueType             VenueType   @default(food_bank) @map("venue_type")
  origin                EntryOrigin @default(scraped)
  confidence            Float       @default(1.0)
  // Lower wins on conflict (freshest-wins precedence). 10 = official authority, 50 = org's
  // own site, 100 = third-party aggregator. Defaults to the weakest tier on purpose.
  sourcePriority        Int         @default(100) @map("source_priority")
  // Match key across sources (domain > phone > name|city|state). Deliberately NOT the
  // @unique fingerprint: a collision here is a useful "same place" signal, not an error.
  normalizedFingerprint String?     @map("normalized_fingerprint")
  // Set when a source that used to list this place no longer does. Null = not observed gone.
  disappearedAt         DateTime?   @map("disappeared_at")
  discoveryStatus  String    @default("indexed") @map("discovery_status") // 'indexed', 'pending_review', 'ignored', 'stale'
  reviewStatus     String    @default("pending") @map("review_status") // 'pending', 'auto_applied', 'approved', 'rejected'
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  nextReviewAt     DateTime? @map("next_review_at")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  region        FoodBankIndexRegion       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  organization  Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  changes       FoodBankDirectoryChange[]
  sourceRecords FoodBankSourceRecord[]
  availabilityWindows FoodBankAvailabilityWindow[]

  @@index([regionId])
  @@index([discoveryStatus, reviewStatus])
  @@index([nextReviewAt])
  @@index([websiteDomain])
  @@index([normalizedPhone])
  @@index([regionId, latitude, longitude])
  @@index([regionId, firstSeenAt(sort: Desc)])
  @@index([regionId, origin, venueType, discoveryStatus])
  @@index([normalizedFingerprint])
  @@map("food_bank_directory_entries")
}

model FoodBankAvailabilityWindow {
  id                String                 @id @default(uuid())
  entryId           String                 @map("entry_id")
  kind              AvailabilityWindowKind
  category          VenueType
  dayOfWeek         Int?                   @map("day_of_week")
  specificDate      DateTime?              @map("specific_date") @db.Date
  startMinute       Int                    @map("start_minute")
  endMinute         Int                    @map("end_minute")
  timezone          String                 @default("America/Chicago")
  recurrenceOrdinal Int?                   @map("recurrence_ordinal")
  sourceText        String?                @map("source_text")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  entry FoodBankDirectoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId], map: "food_availability_entry_idx")
  @@index([kind, category, dayOfWeek, startMinute, endMinute], map: "food_availability_recurring_idx")
  @@index([kind, specificDate, category, startMinute, endMinute], map: "food_availability_date_idx")
  @@map("food_bank_availability_windows")
}

model FoodBankDirectoryChange {
  id            String    @id @default(uuid())
  entryId       String    @map("entry_id")
  runId         String?   @map("run_id")
  changeType    String    @map("change_type") // 'new', 'updated', 'unchanged'
  changedFields String[]  @map("changed_fields")
  previousData  Json?     @map("previous_data")
  nextData      Json?     @map("next_data")
  reviewStatus  String    @default("pending") @map("review_status") // 'pending', 'auto_applied', 'approved', 'rejected'
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  entry FoodBankDirectoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  run   FoodBankIndexRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([entryId, createdAt(sort: Desc)])
  @@index([reviewStatus, createdAt(sort: Desc)])
  @@map("food_bank_directory_changes")
}

model FoodBankSourceRecord {
  id            String   @id @default(uuid())
  regionId      String   @map("region_id")
  runId         String?  @map("run_id")
  entryId       String?  @map("entry_id")
  query         String?
  title         String?
  url           String
  domain        String?
  snippet       String?
  contentHash   String?  @map("content_hash")
  extractedData Json?    @map("extracted_data")
  // --- additive 2026-09-22: reconciliation ---
  matchStatus           SourceMatchStatus @default(unmatched) @map("match_status")
  normalizedFingerprint String?           @map("normalized_fingerprint")
  observedAt            DateTime          @default(now()) @map("observed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  region FoodBankIndexRegion     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  run    FoodBankIndexRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  entry  FoodBankDirectoryEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([regionId, createdAt(sort: Desc)])
  @@index([url])
  @@index([contentHash])
  @@index([normalizedFingerprint])
  @@index([matchStatus])
  @@map("food_bank_source_records")
}

// Per-domain configuration: what we scrape, how much we trust it, and whether it is on.
// This is what makes a new city config-only - sources are rows, not code.
model FoodBankSource {
  id          String   @id @default(uuid())
  domain      String   @unique
  qualityTier Int      @default(3) @map("quality_tier") // 1 = official authority, 2 = org's own site, 3 = aggregator
  authority   String? // human-readable: "Central Texas Food Bank", "City of Austin"
  enabled     Boolean  @default(true)
  regionId    String?  @map("region_id")
  config      Json? // { cadence: 'weekly'|'daily', parserKey, urlPatterns: [...] }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  region FoodBankIndexRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([enabled, qualityTier])
  @@index([regionId])
  @@map("food_bank_sources")
}

model PricingCatalogItem {
  id                String    @id @default(uuid())
  slug              String    @unique
  displayName       String    @map("display_name")
  normalizedName    String    @map("normalized_name")
  category          String?
  aliases           Json?
  defaultSearchTerm String    @map("default_search_term")
  storeSearchTerms  Json?     @map("store_search_terms")
  isStaple          Boolean   @default(true) @map("is_staple")
  isActive          Boolean   @default(true) @map("is_active")
  lastIndexedAt     DateTime? @map("last_indexed_at")
  nextRefreshAt     DateTime? @map("next_refresh_at")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  priceSnapshots PricingSnapshot[]

  @@index([isActive, isStaple, nextRefreshAt])
  @@index([normalizedName])
  @@map("pricing_catalog_items")
}

model PricingSnapshot {
  id           String    @id @default(uuid())
  itemId       String    @map("item_id")
  store        String
  storeQuery   String    @map("store_query")
  productName  String?   @map("product_name")
  productUrl   String?   @map("product_url")
  sourceUrl    String?   @map("source_url")
  packageLabel String?   @map("package_label")
  price        Float?
  currency     String    @default("USD")
  availability String    @default("unknown")
  freshness    String    @default("fresh")
  scrapedAt    DateTime  @default(now()) @map("scraped_at")
  expiresAt    DateTime? @map("expires_at")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  item PricingCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, store])
  @@index([store, scrapedAt(sort: Desc)])
  @@index([freshness, expiresAt])
  @@map("pricing_snapshots")
}

model PricingSyncRun {
  id           String    @id @default(uuid())
  scope        String    @default("catalog")
  trigger      String    @default("scheduler")
  status       String    @default("running")
  requestedBy  String?   @map("requested_by")
  itemCount    Int       @default(0) @map("item_count")
  updatedCount Int       @default(0) @map("updated_count")
  failedCount  Int       @default(0) @map("failed_count")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([scope, createdAt(sort: Desc)])
  @@map("pricing_sync_runs")
}

model EventVolunteer {
  id                 String    @id @default(uuid())
  eventId            String    @map("event_id")
  volunteerId        String?   @map("volunteer_id")
  volunteerSessionId String?   @map("volunteer_session_id")
  volunteerType      String    @map("volunteer_type") // 'cooking', 'setup', 'serving', 'cleanup', 'hosting'
  capacityOffered    Int?      @map("capacity_offered") // How many people they can help serve
  availableFrom      DateTime? @map("available_from")
  availableTo        DateTime? @map("available_to")
  specialSkills      String?   @map("special_skills")
  notes              String?
  status             String    @default("signed_up") // 'signed_up', 'confirmed', 'completed', 'cancelled'
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
  @@unique([eventId, volunteerSessionId])
  @@index([eventId])
  @@index([volunteerId])
  @@index([volunteerSessionId])
  @@index([volunteerType])
  @@map("event_volunteers")
}

model EventResource {
  id                String   @id @default(uuid())
  eventId           String   @map("event_id")
  providerId        String?  @map("provider_id")
  providerSessionId String?  @map("provider_session_id")
  resourceType      String   @map("resource_type") // 'venue', 'equipment', 'supplies', 'transportation'
  resourceName      String   @map("resource_name")
  quantity          String? // e.g., "1 grill", "tables for 50", "sound system"
  capacity          Int? // How many people this resource can serve
  notes             String?
  status            String   @default("offered") // 'offered', 'confirmed', 'delivered', 'returned'
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([providerId])
  @@index([providerSessionId])
  @@index([resourceType])
  @@map("event_resources")
}

model EventMealPlan {
  id                String   @id @default(uuid())
  eventId           String   @unique @map("event_id")
  menuItems         Json     @map("menu_items") // Array of menu items with ingredients
  shoppingList      Json     @map("shopping_list") // Generated shopping list with quantities
  nutritionAnalysis Json?    @map("nutrition_analysis") // Nutritional breakdown per serving
  allergenInfo      Json?    @map("allergen_info") // Allergen warnings and alternatives
  cookingTimeline   Json?    @map("cooking_timeline") // Step-by-step cooking schedule
  totalCostCents    Int?     @map("total_cost_cents")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_meal_plans")
}

model EventDietaryProfile {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  userId              String?  @map("user_id")
  sessionId           String?  @map("session_id")
  allergies           String[] // Array of allergens
  dietaryRestrictions String[] @map("dietary_restrictions") // 'vegetarian', 'vegan', 'gluten_free', etc.
  preferences         String[] // Food preferences
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([eventId, sessionId])
  @@index([eventId])
  @@index([userId])
  @@index([sessionId])
  @@map("event_dietary_profiles")
}

// Enhanced Transparency Tables
model ExpenseCategory {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?
  parentCategoryId String?  @map("parent_category_id")
  colorCode        String?  @map("color_code") // For UI display
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  parentCategory ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories  ExpenseCategory[] @relation("CategoryHierarchy")
  expenses       DetailedExpense[]

  @@index([parentCategoryId])
  @@map("expense_categories")
}

model DetailedExpense {
  id            String   @id @default(uuid())
  ledgerEntryId String   @map("ledger_entry_id")
  categoryId    String   @map("category_id")
  vendor        String?
  description   String?
  amountCents   Int      @map("amount_cents")
  receiptUrl    String?  @map("receipt_url")
  tags          String[] // Searchable tags
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  ledgerEntry   LedgerEntry     @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  receiptPhotos ReceiptPhoto[]

  @@index([ledgerEntryId])
  @@index([categoryId])
  @@index([vendor])
  @@map("detailed_expenses")
}

model ImpactMetric {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metricType     String   @map("metric_type") // 'meals_served', 'families_helped', 'pounds_distributed'
  value          Float
  period         String // 'daily', 'weekly', 'monthly', 'quarterly', 'yearly'
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  calculatedAt   DateTime @default(now()) @map("calculated_at")
  metadata       Json? // Additional metric details

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricType, period, periodStart])
  @@index([organizationId])
  @@index([metricType])
  @@index([period])
  @@index([calculatedAt])
  @@map("impact_metrics")
}

model ReceiptPhoto {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  ledgerEntryId  String?   @map("ledger_entry_id")
  expenseId      String?   @map("expense_id")
  photoUrl       String    @map("photo_url")
  thumbnailUrl   String?   @map("thumbnail_url")
  originalName   String    @map("original_name")
  fileSize       Int       @map("file_size") // bytes
  mimeType       String    @map("mime_type")
  description    String?
  vendor         String?
  amountCents    Int?      @map("amount_cents")
  expenseDate    DateTime? @map("expense_date")
  tags           String[] // searchable tags
  isPublic       Boolean   @default(true) @map("is_public") // for transparency
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntry     LedgerEntry?     @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  detailedExpense DetailedExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ledgerEntryId])
  @@index([expenseId])
  @@index([createdAt(sort: Desc)])
  @@index([isPublic])
  @@index([vendor])
  @@map("receipt_photos")
}

// Nutrition Data Cache
model NutritionDataCache {
  id            String   @id @default(uuid())
  usdaFdcId     String   @unique @map("usda_fdc_id")
  foodName      String   @map("food_name")
  nutritionData Json     @map("nutrition_data") // Complete USDA nutrition profile
  allergenData  Json?    @map("allergen_data") // Known allergen information
  lastUpdated   DateTime @default(now()) @map("last_updated")

  @@index([foodName])
  @@map("nutrition_data_cache")
}

model GrantWorkspace {
  id                  String    @id @default(uuid())
  actorUserId         String?   @map("actor_user_id")
  actorSessionId      String?   @map("actor_session_id")
  title               String    @default("New grant chat")
  status              String    @default("active") // 'active', 'running', 'paused', 'archived'
  organizationName    String    @default("MVOE") @map("organization_name")
  mission             String?
  location            String?
  populationServed    String?   @map("population_served")
  projectNeed         String?   @map("project_need")
  amountTarget        String?   @map("amount_target")
  grantType           String?   @map("grant_type")
  websiteUrl          String?   @map("website_url")
  socialUrl           String?   @map("social_url")
  existingPrograms    String?   @map("existing_programs")
  notes               String?
  selectedOpportunity Json?     @map("selected_opportunity")
  lastRunMode         String?   @map("last_run_mode")
  lastRunAt           DateTime? @map("last_run_at")
  lastActivityAt      DateTime  @default(now()) @map("last_activity_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  actorUser       User?                          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  messages        GrantWorkspaceMessage[]
  drafts          GrantApplicationDraft[]
  driveConnection GrantWorkspaceDriveConnection?
  driveSyncs      GrantDriveSync[]

  @@index([actorUserId])
  @@index([actorSessionId])
  @@index([lastActivityAt(sort: Desc)])
  @@map("grant_workspaces")
}

model GrantWorkspaceMessage {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  role        String // 'user', 'assistant', 'system', 'error'
  kind        String   @default("chat") // 'chat', 'progress', 'status'
  content     String
  mode        String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace GrantWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drafts    GrantApplicationDraft[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([role])
  @@map("grant_workspace_messages")
}

model GrantApplicationDraft {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  sourceMessageId String?   @map("source_message_id")
  artifactType    String    @map("artifact_type") // 'grant_brief', 'opportunity_search', 'application_preparation'
  title           String
  summary         String?
  status          String    @default("needs_review") // 'needs_review', 'approved', 'disapproved'
  version         Int       @default(1)
  data            Json
  driveFileId     String?   @map("drive_file_id")
  driveFileUrl    String?   @map("drive_file_url")
  driveFileName   String?   @map("drive_file_name")
  driveSyncedAt   DateTime? @map("drive_synced_at")
  reviewNotes     String?   @map("review_notes")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace     GrantWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMessage GrantWorkspaceMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  driveSyncs    GrantDriveSync[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("grant_application_drafts")
}

model GrantWorkspaceDriveConnection {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique @map("workspace_id")
  provider            String    @default("composio")
  toolkitSlug         String    @default("googledrive") @map("toolkit_slug")
  status              String    @default("disconnected") // 'disconnected', 'initiated', 'connected', 'failed'
  connectionRequestId String?   @map("connection_request_id")
  connectedAccountId  String?   @map("connected_account_id")
  redirectUrl         String?   @map("redirect_url")
  connectedAt         DateTime? @map("connected_at")
  lastCheckedAt       DateTime? @map("last_checked_at")
  errorMessage        String?   @map("error_message")
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  workspace GrantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("grant_workspace_drive_connections")
}

model GrantDriveSync {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  draftId      String?   @map("draft_id")
  provider     String    @default("google_drive")
  status       String    @default("pending") // 'pending', 'synced', 'failed'
  fileId       String?   @map("file_id")
  fileUrl      String?   @map("file_url")
  fileName     String?   @map("file_name")
  errorMessage String?   @map("error_message")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  syncedAt     DateTime? @map("synced_at")

  workspace GrantWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  draft     GrantApplicationDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("grant_drive_syncs")
}

// Image bytes live in Postgres because Render's filesystem is ephemeral —
// uploads written to disk vanish on every redeploy.
model StoredImage {
  id        String   @id @default(uuid())
  data      Bytes
  mimeType  String   @map("mime_type")
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stored_images")
}

/// A person or group offering food right now. Short-lived by design: a beacon
/// represents "I have food available at this spot until expiresAt", not a venue.
/// Food banks are Organizations; beacons are everyone else.
model Beacon {
  id           String   @id @default(uuid())
  title        String
  description  String?
  foodType     String?  @map("food_type") // 'produce', 'prepared', 'pantry', 'bakery', 'other'
  servings     Int?
  latitude     Float
  longitude    Float
  address      String?
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  createdBy    String?  @map("created_by") // User id when authenticated
  isActive     Boolean  @default(true) @map("is_active")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([latitude, longitude])
  @@index([expiresAt])
  @@index([isActive])
  @@map("beacons")
}
