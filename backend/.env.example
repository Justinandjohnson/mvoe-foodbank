# Mvoe Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/mvoe_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Stripe Configuration
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Server Configuration
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# CORS Configuration
FRONTEND_URL=http://localhost:8083

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# USDA FoodData Central API (for nutrition data)
# Get your API key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# Mapbox (for geocoding and maps)
# Get your API key at: https://www.mapbox.com/
MAPBOX_API_KEY=your_mapbox_api_key_here

# Google Sheets MCP (for expense tracking and analysis)
# Get your spreadsheet ID from the Google Sheets URL
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# OpenAI API (for image generation via DALLE-3/gpt-image-1)
# Get your API key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Mailtrap MCP (for email sending and newsletters)
# Get your API token at: https://mailtrap.io/
MAILTRAP_API_TOKEN=your_mailtrap_api_token_here
MAILTRAP_FROM_EMAIL=noreply@yourdomain.com
MAILTRAP_TEST_EMAIL=test@yourdomain.com
MAILTRAP_ACCOUNT_ID=your_account_id
MAILTRAP_TEST_INBOX_ID=your_test_inbox_id
